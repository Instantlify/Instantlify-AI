FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG BACKEND_INTERNAL_URL=http://backend:8000
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8000
ARG NEMIO_PRIVACY_URL=
ARG NEMIO_TERMS_URL=
ARG NEMIO_SUPPORT_EMAIL=
ENV NEMIO_PRIVACY_URL=$NEMIO_PRIVACY_URL NEMIO_TERMS_URL=$NEMIO_TERMS_URL NEMIO_SUPPORT_EMAIL=$NEMIO_SUPPORT_EMAIL
ENV BACKEND_INTERNAL_URL=$BACKEND_INTERNAL_URL NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ARG NEMIO_PRIVACY_URL=
ARG NEMIO_TERMS_URL=
ARG NEMIO_SUPPORT_EMAIL=
ENV NEMIO_PRIVACY_URL=$NEMIO_PRIVACY_URL NEMIO_TERMS_URL=$NEMIO_TERMS_URL NEMIO_SUPPORT_EMAIL=$NEMIO_SUPPORT_EMAIL
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
