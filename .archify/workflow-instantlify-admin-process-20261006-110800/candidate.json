      "label": "route request",
      "variant": "emphasis"
    },
    {
      "id": "e_rag_prompt",
      "from": "rag_vector",
      "to": "prompt_studio",
      "label": "knowledge chunks",
      "variant": "dashed"
    },
    {
      "id": "e_prompt_llm",
      "from": "prompt_studio",
      "to": "doc_ingest",
      "label": "synthesized prompt",
      "variant": "emphasis"
