{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Instantlify Platform Architecture",
    "subtitle": "Containerized Next.js frontend, Django ASGI backend, Celery workers, and pgvector persistence",
    "output": "instantlify-platform.html",
    "visual_preset": "classic",
    "quality_profile": "showcase"
  },
  "components": [
    {
      "id": "users",
      "type": "external",
      "label": "Workspace Users",
      "sublabel": "Browser / Mobile Clients",
      "pos": [50, 190],
      "size": [140, 60]
    },
    {
      "id": "channels",
      "type": "external",
      "label": "Inbound Channels",
      "sublabel": "WhatsApp / Webhooks",
      "pos": [50, 360],
      "size": [140, 60]
    },
    {
      "id": "frontend",
      "type": "frontend",
      "label": "Next.js Frontend",
      "sublabel": "App Router :3000",
      "brand": "next-js",
      "pos": [280, 190],
      "size": [150, 60]
    },
    {
      "id": "backend",
      "type": "backend",
      "label": "Django ASGI Core",
      "sublabel": "Uvicorn :8000",
      "brand": "django",
      "pos": [540, 190],
      "size": [160, 64]
    },
    {
      "id": "beat",
      "type": "backend",
      "label": "Celery Beat",
      "sublabel": "Periodic Scheduler",
      "brand": "python",
      "pos": [540, 360],
      "size": [160, 60]
    },
    {
      "id": "redis",
      "type": "database",
      "label": "Redis 7.4",
      "sublabel": "Cache & Broker :6379",
      "brand": "redis",
      "pos": [830, 190],
      "size": [150, 60]
    },
    {
      "id": "postgres",
      "type": "database",
      "label": "PostgreSQL 17",
      "sublabel": "pgvector :5432",
      "brand": "postgresql",
      "pos": [830, 360],
      "size": [150, 64]
    },
    {
      "id": "worker",
      "type": "backend",
      "label": "Celery Workers",
      "sublabel": "AI Agents & RAG Tasks",
      "brand": "python",
      "pos": [1100, 190],
      "size": [150, 60]
    },
    {
      "id": "llm_apis",
      "type": "cloud",
      "label": "LLM Providers",
      "sublabel": "OpenAI / Claude / Gemini",
      "brand": "openai",
      "pos": [1370, 110],
      "size": [145, 60]
    },
    {
      "id": "channel_meta",
      "type": "cloud",
      "label": "Channel APIs",
      "sublabel": "Meta WhatsApp Cloud",
      "brand": "whatsapp",
      "pos": [1370, 250],
      "size": [145, 60]
    },
    {
      "id": "billing_svc",
      "type": "external",
      "label": "Stripe Gateway",
      "sublabel": "Subscriptions & Billing",
      "brand": "stripe",
      "pos": [1370, 390],
      "size": [145, 60]
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "Instantlify Container Platform (Docker Compose)",
      "wraps": ["frontend", "backend", "beat", "redis", "postgres", "worker"],
      "pad": 24
    },
    {
      "kind": "security-group",
      "label": "Application & Persistence Network",
      "wraps": ["backend", "beat", "redis", "postgres", "worker"],
      "pad": 16
    }
  ],
  "connections": [
    {
      "id": "conn-users-frontend",
      "from": "users",
      "to": "frontend",
      "label": "HTTPS :3000",
      "variant": "emphasis"
    },
    {
      "id": "conn-channels-backend",
      "from": "channels",
      "to": "backend",
      "label": "Webhook Inbound"
    },
    {
      "id": "conn-frontend-backend",
      "from": "frontend",
      "to": "backend",
      "label": "REST & WS :8000",
      "variant": "emphasis"
    },
    {
      "id": "conn-backend-redis",
      "from": "backend",
      "to": "redis",
      "label": "Channel Layer & Cache",
      "route": "straight"
    },
    {
      "id": "conn-backend-postgres",
      "from": "backend",
      "to": "postgres",
      "label": "SQL & Tenancy"
    },
    {
      "id": "conn-beat-redis",
      "from": "beat",
      "to": "redis",
      "label": "Task Schedule",
      "fromSide": "right",
      "toSide": "bottom"
    },
    {
      "id": "conn-redis-worker",
      "from": "redis",
      "to": "worker",
      "label": "Celery Broker",
      "route": "straight"
    },
    {
      "id": "conn-worker-postgres",
      "from": "worker",
      "to": "postgres",
      "label": "pgvector Embeddings",
      "fromSide": "bottom",
      "toSide": "right"
    },
    {
      "id": "conn-worker-llm",
      "from": "worker",
      "to": "llm_apis",
      "label": "Prompt & Inference",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "conn-worker-meta",
      "from": "worker",
      "to": "channel_meta",
      "label": "Outbound Send",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "conn-backend-billing",
      "from": "backend",
      "to": "billing_svc",
      "label": "Billing Events",
      "fromSide": "bottom",
      "toSide": "left"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend & Interaction",
      "items": [
        "Next.js 15 App Router serves workspace dashboard and agent builder",
        "Direct WebSocket connection to Django ASGI channels for streaming chat"
      ]
    },
    {
      "dot": "emerald",
      "title": "AI & Task Orchestration",
      "items": [
        "Celery background workers execute agent tool calls and RAG pipelines",
        "Redis provides distributed broker queues and low-latency cache",
        "Integration with OpenAI, Anthropic, and Gemini models"
      ]
    },
    {
      "dot": "violet",
      "title": "Persistence & Multi-Tenancy",
      "items": [
        "PostgreSQL 17 stores relational tenant schemas, CRM data, and audit trails",
        "pgvector extension manages vector embeddings for document retrieval",
        "Stripe webhook listeners manage recurring subscriptions"
      ]
    }
  ]
}
