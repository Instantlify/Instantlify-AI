      "width": 140
    },
    {
      "id": "rag_retrieval",
      "lane": "lane_store",
      "col": 2,
      "type": "database",
      "label": "RAG Vector Search",
      "sublabel": "pgvector top-k chunks",
      "brand": "postgresql",
      "tag": "Cosine Similarity",
      "width": 150
    },
    {
      "id": "prompt_builder",
      "lane": "lane_agent",
      "col": 2,
