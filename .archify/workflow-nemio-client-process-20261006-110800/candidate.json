      "from": "tenant_ingress",
      "to": "session_lookup",
      "label": "load state",
      "variant": "dashed"
    },
    {
      "id": "e_ingress_prompt",
      "from": "tenant_ingress",
      "to": "prompt_builder",
      "label": "route request",
      "variant": "emphasis"
    },
    {
      "id": "e_rag_prompt",
      "from": "rag_retrieval",
      "to": "prompt_builder",
      "label": "knowledge chunks",
      "variant": "dashed"
    },
    {
      "id": "e_prompt_llm",
      "from": "prompt_builder",
      "to": "llm_reasoning",
      "label": "synthesized prompt",
      "variant": "emphasis"
    },
    {
      "id": "e_llm_tool",
      "from": "llm_reasoning",
      "to": "tool_exec",
      "label": "function call",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e_tool_stream",
      "from": "tool_exec",
      "to": "stream_engine",
      "label": "tool output",
      "variant": "dashed"
    },
    {
      "id": "e_llm_stream",
      "from": "llm_reasoning",
      "to": "stream_engine",
      "label": "stream tokens",
      "variant": "emphasis"
    },
    {
      "id": "e_stream_client",
      "from": "stream_engine",
      "to": "client_reply",
      "label": "push to UI",
      "variant": "emphasis"
    },
    {
      "id": "e_stream_persist",
      "from": "stream_engine",
      "to": "audit_persist",
      "label": "save log & tokens",
      "variant": "dashed",
      "role": "async"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Client Ingress & Security",
      "items": [
        "Inbound traffic from custom domains or WhatsApp webhooks hits the ASGI gateway",
        "Tenant identifier is strictly validated, enforcing isolation and rate limiting"
      ]
    },
    {
      "dot": "emerald",
      "title": "Knowledge Retrieval & Tools",
      "items": [
        "pgvector cosine similarity pulls the most relevant workspace knowledge chunks",
        "The agent dynamically detects when external actions (CRM update, meeting booking) are needed before finishing"
      ]
    },
    {
      "dot": "violet",
      "title": "Real-Time Streaming & Audit",
      "items": [
        "Tokens stream through Django Channels WebSockets for instant response UX",
        "Full conversation transcripts, token costs, and lead metrics are committed to PostgreSQL"
      ]
    }
  ]
}
