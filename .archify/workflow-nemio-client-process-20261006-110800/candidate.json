    { "id": "lane_store", "label": "State, Vectors & Analytics" }
  ],
  "phases": [
    { "id": "phase_intake", "label": "1. Intake & Auth", "fromCol": 0, "toCol": 1, "variant": "emphasis" },
    { "id": "phase_rag", "label": "2. Context & RAG Search", "fromCol": 2, "toCol": 2 },
    { "id": "phase_reasoning", "label": "3. AI Reasoning & Tools", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "phase_output", "label": "4. Stream & Persist", "fromCol": 5, "toCol": 5, "variant": "dashed" }
