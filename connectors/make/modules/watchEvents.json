{
  "name": "watchEvents",
  "label": "Watch Events",
  "description": "Triggers instantly when Nemio emits a subscribed event (lead, message, handoff, booking, payment).",
  "type": "instant_trigger",
  "connection": "nemio",
  "webhook": "nemio",
  "communication": {
    "output": "{{payload}}"
  },
  "interface": [
    { "name": "delivery_id", "type": "text", "label": "Delivery ID" },
    { "name": "event", "type": "text", "label": "Event" },
    { "name": "occurred_at", "type": "date", "label": "Occurred at" },
    { "name": "workspace_id", "type": "text", "label": "Workspace ID" },
    {
      "name": "data",
      "type": "collection",
      "label": "Data",
      "spec": [
        { "name": "id", "type": "text", "label": "ID" },
        { "name": "name", "type": "text", "label": "Name" },
        { "name": "email", "type": "email", "label": "Email" },
        { "name": "stage", "type": "text", "label": "Stage" },
        { "name": "tags", "type": "array", "label": "Tags" },
        { "name": "conversation_id", "type": "text", "label": "Conversation ID" },
        { "name": "lead_id", "type": "text", "label": "Lead ID" },
        { "name": "text", "type": "text", "label": "Text" },
        { "name": "amount_cents", "type": "number", "label": "Amount (cents)" }
      ]
    }
  ]
}
