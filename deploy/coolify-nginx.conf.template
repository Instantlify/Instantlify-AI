# Coolify terminates TLS, then forwards privately to this HTTP gateway.
# Two proxies (Coolify + this gateway) are counted by Django.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name ${APP_DOMAIN};
    # Access query strings may contain OAuth credentials; do not log them.
    access_log off;
    client_max_body_size 50m;

    # Container healthcheck: answers from Nginx itself, independent of upstreams,
    # so a backend restart does not make Traefik drop the gateway route.
    # Exact match only; /health/live/ and /health/ready/ still go to the backend.
    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }

    location ~ ^/(api/|webhooks/|health/|ws/|media/voice/) {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://frontend:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 80;
    server_name ${PLATFORM_ADMIN_HOST};
    access_log off;
    client_max_body_size 50m;

    location / {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
