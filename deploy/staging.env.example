# staging configuration template. Copy to .env.staging in the repository root.
# Supply fresh environment-specific secrets and SMTP credentials before deployment.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=GENERATE_WITH_BOOTSTRAP
FIELD_ENCRYPTION_KEYS=GENERATE_WITH_BOOTSTRAP
POSTGRES_DB=nemio
POSTGRES_USER=nemio
POSTGRES_PASSWORD=GENERATE_WITH_BOOTSTRAP
DATABASE_URL=postgresql://nemio:GENERATE_WITH_BOOTSTRAP@postgres:5432/nemio
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
ALLOWED_HOSTS=staging.instantlify.com,ops.staging.instantlify.com,backend
CSRF_TRUSTED_ORIGINS=https://staging.instantlify.com,https://ops.staging.instantlify.com
BACKEND_INTERNAL_URL=http://backend:8000
CHANNEL_ADAPTER_MODE=disabled
ALLOW_TEST_CHANNELS=false
FLOWER_BASIC_AUTH=local:GENERATE_WITH_BOOTSTRAP

# Phase 1 only; Phase 0 does not call Meta or require live keys.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://staging.instantlify.com/api/meta/callback/
META_SCOPES=instagram_business_basic,instagram_business_manage_messages
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Facebook Login for Business configuration using the WhatsApp Embedded Signup flow.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
MESSENGER_APP_SECRET=
# LinkedIn messaging access is not granted to ordinary apps. Leave this false until
# a real account has connected and delivered a reply; the channel stays unavailable
# until then, credentials or not.
LINKEDIN_MESSAGING_APPROVED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://staging.instantlify.com/api/linkedin/callback/
SNAPCHAT_WEBHOOK_SECRET=
PUBLIC_APP_URL=https://staging.instantlify.com
NEXT_PUBLIC_WS_URL=wss://staging.instantlify.com

# Optional: platform billing, calendar OAuth, error tracking.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICES={}
MARKETPLACE_FEE_PERCENT=15
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Also enables "Continue with Google" sign-in. Register this redirect URI in Google Cloud:
#   <PUBLIC_APP_URL>/api/auth/google/callback/  (override with GOOGLE_LOGIN_REDIRECT_URI)
GOOGLE_LOGIN_REDIRECT_URI=https://staging.instantlify.com/api/auth/google/callback/
SENTRY_DSN=
PLATFORM_ADMIN_HOST=ops.staging.instantlify.com
# Optional CIDRs checked against the caller's address; also enforce this at your
# proxy/VPN. Set TRUSTED_PROXY_DEPTH below or every caller looks like the proxy.
PLATFORM_ADMIN_NETWORKS=
# Reverse proxies between the internet and Django. 0 when Django is reached directly
# (local dev). The edge proxy in deploy/ is one hop, so production sets 1. It decides
# the caller's address for the console allow-list, the console login lockout and every
# anonymous rate limit; production refuses to start at 0.
TRUSTED_PROXY_DEPTH=1

# --- Platform AI keys (prepaid credits, segment classification, support bot) --------
PLATFORM_OPENAI_API_KEY=
# Model for Instantlify support chat and business classification; must be enabled for the key's project.
PLATFORM_AI_MODEL=gpt-5
# Used by agents set to that provider (and as fallbacks) on prepaid credits:
PLATFORM_ANTHROPIC_API_KEY=
PLATFORM_GEMINI_API_KEY=
# Model used by the Gemini provider health test.
PLATFORM_GEMINI_MODEL=gemini-3.5-flash-lite
PLATFORM_XAI_API_KEY=
# Platform-managed voice synthesis (ElevenLabs zero-key mode for clients):
PLATFORM_ELEVENLABS_API_KEY=
PLATFORM_ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Extra named keys per provider only get their own console health card:
# PLATFORM_ANTHROPIC_API_KEY_MARKO=  PLATFORM_ANTHROPIC_API_KEY_BAZIL=

# --- Uptime paging (optional; see deploy/ and platform_ops/uptime.py) ---------------
# Public readiness URL probed every minute, e.g. https://instantlify.com/health/ready/
UPTIME_PROBE_URL=https://staging.instantlify.com/health/ready/
UPTIME_LATENCY_MS=2500
# Slack-compatible incoming webhook and/or PagerDuty Events API v2 routing key:
ALERT_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# --- Transactional email (required in production) -----------------------------------
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=support@instantlify.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Instantlify <support@instantlify.com>

# --- Integrations ---------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Optional tuning (defaults shown) ---------------------------------------------
META_API_VERSION=v23.0
META_CALLS_PER_HOUR=200
META_APP_CALLS_PER_HOUR=0
WHATSAPP_CALLS_PER_HOUR=3600
TELEGRAM_CALLS_PER_HOUR=1800
MESSENGER_CALLS_PER_HOUR=3600
STRIPE_TRIAL_DAYS=3
STRIPE_METER_EVENT_NAME=ai_messages
DEFAULT_PLAN_SLUG=free
PUBLIC_API_RATE=600/min
RETENTION_DAYS=90

# Published policies and public support contact. Rebuild frontend after changing.
# Policy links appear only when valid HTTPS URLs are configured.
NEMIO_PRIVACY_URL=
NEMIO_TERMS_URL=
NEMIO_SUPPORT_EMAIL=

# Optional FirstPromoter referral program (server-only credentials).
FIRSTPROMOTER_API_KEY=
FIRSTPROMOTER_ACCOUNT_ID=
FIRSTPROMOTER_CAMPAIGN_ID=0
FIRSTPROMOTER_CURRENCY=USD
# Match the amount units configured in your FirstPromoter account.
FIRSTPROMOTER_REVENUE_DIVISOR=100

# Instantlify public identity (legacy NEMIO_* names remain accepted).
INSTANTLIFY_PRIVACY_URL=https://staging.instantlify.com/privacy/
INSTANTLIFY_TERMS_URL=https://staging.instantlify.com/terms/
INSTANTLIFY_SUPPORT_EMAIL=support@instantlify.com
INSTANTLIFY_PRIVACY_EMAIL=support@instantlify.com

# Public identity for this deployment.
APP_DOMAIN=staging.instantlify.com
CUSTOM_DOMAIN_CNAME_TARGET=staging.instantlify.com

# Use the same file for Compose interpolation and backend container configuration.
NEMIO_ENV_FILE=.env.staging
ACME_EMAIL=support@instantlify.com
